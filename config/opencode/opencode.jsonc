{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-auto-update",
    "oh-my-openagent",
    "opencode-adaptive-thinking",
    ["{env:HOME}/.config/opencode/race-control/race-control.js", {}]
  ],
  "provider": {
    "race-control": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Race Control",
      "options": {
        "baseURL": "http://192.168.1.253:8317/v1"
      }
    }
  },
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @agentmemory/mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @playwright/mcp"
      ],
      "enabled": true
    }
  }
}