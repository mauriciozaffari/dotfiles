{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-auto-update@0.3.1",
    "oh-my-openagent@4.19.2",
    "opencode-adaptive-thinking@0.1.5"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @agentmemory/mcp"
      ],
      "environment": {
        "ASDF_NODEJS_VERSION": "24.18.0"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @playwright/mcp"
      ],
      "enabled": true
    }
  }
}