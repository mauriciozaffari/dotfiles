{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-claude-auth@latest",
    "opencode-antigravity-auth@latest"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@agentmemory/mcp"
      ],
      "enabled": true
    }
  }
}