{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "opencode-plugin-auto-update",
    "oh-my-openagent@latest",
    "opencode-adaptive-thinking",
    "@expiren/opencode-antigravity-auth"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @agentmemory/mcp"
      ],
      "environment": {
        "ASDF_NODEJS_VERSION": "24.18.0"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @playwright/mcp"
      ],
      "enabled": true
    }
  },
  "provider": {
    "race-control": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Race Control",
      "options": {
        "baseURL": "http://192.168.1.253:8317/v1"
      },
      "models": {
        "p1": {
          "name": "P1",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "high": {
              "reasoning_effort": "high"
            },
            "xhigh": {
              "reasoning_effort": "xhigh"
            },
            "max": {
              "reasoning_effort": "max"
            }
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "p2": {
          "name": "P2",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "high": {
              "reasoning_effort": "high"
            },
            "xhigh": {
              "reasoning_effort": "xhigh"
            },
            "max": {
              "reasoning_effort": "max"
            }
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "p3": {
          "name": "P3",
          "limit": {
            "context": 1048576,
            "output": 65536
          },
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "high": {
              "reasoning_effort": "high"
            },
            "xhigh": {
              "reasoning_effort": "xhigh"
            },
            "max": {
              "reasoning_effort": "max"
            }
          },
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gt3": {
          "name": "GT3",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "variants": {
            "low": {
              "reasoning_effort": "low"
            },
            "medium": {
              "reasoning_effort": "medium"
            },
            "high": {
              "reasoning_effort": "high"
            },
            "xhigh": {
              "reasoning_effort": "xhigh"
            },
            "max": {
              "reasoning_effort": "max"
            }
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "gt4": {
          "name": "GT4",
          "limit": {
            "context": 200000,
