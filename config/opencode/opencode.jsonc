{
  "$schema": "https://opencode.ai/config.json",
  "plugin": [
    "oh-my-openagent@latest",
    "opencode-claude-auth@latest",
    "@expiren/opencode-antigravity-auth",
    // "opencode-adaptive-thinking"
  ],
  "mcp": {
    "agentmemory": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @agentmemory/mcp"
      ],
      "environment": {
        "ASDF_NODEJS_VERSION": "24.18.0"
      },
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; exec npx -y @playwright/mcp"
      ],
      "enabled": true
    },
    "home-assistant": {
      "type": "local",
      "enabled": false,
      "timeout": 60000,
      "command": [
        "sh",
        "-lc",
        "export PATH=\"$HOME/.asdf/shims:$HOME/.local/bin:$PATH\"; set -a; [ -f \"$HOME/.config/opencode/mcp/ha.env\" ] && . \"$HOME/.config/opencode/mcp/ha.env\"; set +a; exec uvx ha-mcp@latest"
      ]
    },
    "sentry": {
      "type": "remote",
      "enabled": false,
      "url": "https://mcp.sentry.dev/mcp"
    }
  },
  "provider": {
    "google": {
      "npm": "@ai-sdk/google",
      "models": {
        "p1-low": {
          "name": "Race Control P1 Low",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "p1-medium": {
          "name": "Race Control P1 Medium",
          "limit": {
            "context": 200000,
            "output": 64000
          },
          "modalities": {
            "input": [
              "text",
              "image",
              "pdf"
            ],
            "output": [
              "text"
            ]
          }
        },
        "p1-high": {
          "name": "Race Control P1 High",
