{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "codegraph": {
    "auto_init": true,
    "auto_provision": true,
    "enabled": true,
    "telemetry": false,
    "daemon": false
  },
  "notification": {
    "force_enable": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-horizontal",
    "main_pane_size": 60,
    "main_pane_min_width": 40,
    "agent_pane_min_width": 40,
    "isolation": "inline"
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "agents": {
    "sisyphus": {
      "model": "race-control/p1",
      "reasoningEffort": "high"
    },
    "hephaestus": {
      "model": "race-control/p1:h",
      "reasoningEffort": "medium"
    },
    "oracle": {
      "model": "race-control/p1:h",
      "reasoningEffort": "xhigh"
    },
    "explore": {
      "model": "race-control/p3",
      "reasoningEffort": "low"
    },
    "multimodal-looker": {
      "model": "race-control/gt3"
    },
    "prometheus": {
      "model": "race-control/p1",
      "reasoningEffort": "max"
    },
    "metis": {
      "model": "race-control/p2"
    },
    "momus": {
      "model": "race-control/p2"
    },
    "atlas": {
      "model": "race-control/p2"
    },
    "librarian": {
      "model": "race-control/p3"
    },
    "sisyphus-junior": {
      "model": "race-control/p2"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "race-control/gt3"
    },
    "ultrabrain": {
      "model": "race-control/p1:h"
    },
    "deep": {
      "model": "race-control/p1:h"
    },
    "artistry": {
      "model": "race-control/gt3"
    },
    "quick": {
      "model": "race-control/p3"
    },
    "unspecified-low": {
      "model": "race-control/p3"
    },
    "unspecified-high": {
      "model": "race-control/p2"
    },
    "writing": {
      "model": "race-control/p3"
    }
  }
}