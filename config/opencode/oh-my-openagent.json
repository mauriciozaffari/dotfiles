{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "codegraph": {
    "auto_init": true,
    "auto_provision": true,
    "enabled": true,
    "telemetry": false
  },
  "notification": {
    "force_enable": true
  },
  "model_fallback": false,
  "runtime_fallback": {
    "enabled": false,
    "retry_on_errors": [
      408,
      409,
      429,
      500,
      502,
      503,
      504,
      529
    ],
    "max_fallback_attempts": 6,
    "cooldown_seconds": 300,
    "timeout_seconds": 120,
    "notify_on_fallback": true,
    "restore_primary_after_cooldown": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-horizontal",
    "main_pane_size": 60,
    "main_pane_min_width": 40,
    "agent_pane_min_width": 40,
    "isolation": "inline"
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "agents": {
    "sisyphus": {
      "model": "race-control/p1-high"
    },
    "hephaestus": {
      "model": "race-control/p2-max"
    },
    "oracle": {
      "model": "race-control/p3-xhigh"
    },
    "explore": {
      "model": "race-control/gt4-low"
    },
    "multimodal-looker": {
      "model": "race-control/gt3-medium"
    },
    "prometheus": {
      "model": "race-control/gt3-medium"
    },
    "metis": {
      "model": "race-control/gt4-low"
    },
    "momus": {
      "model": "race-control/p3-xhigh"
    },
    "atlas": {
      "model": "race-control/p2-max"
    },
    "sisyphus-junior": {
      "model": "race-control/gt4-low"
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "race-control/gt3-medium"
    },
    "ultrabrain": {
      "model": "race-control/p3-xhigh"
    },
    "deep": {
      "model": "race-control/p2-max"
    },
    "artistry": {
      "model": "race-control/p2-max"
    },
    "quick": {
      "model": "race-control/gt4-low"
    },
    "unspecified-low": {
      "model": "race-control/gt4-low"
    },
    "unspecified-high": {
      "model": "race-control/p2-max"
    },
    "writing": {
      "model": "race-control/gt3-medium"
    }
  }
}