{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "telemetry": false,
  "codegraph": {
    "auto_init": true,
    "auto_provision": true,
    "enabled": true,
    "telemetry": false
  },
  "notification": {
    "force_enable": true
  },
  "model_fallback": true,
  "runtime_fallback": {
    "enabled": true,
    "retry_on_errors": [408, 409, 429, 500, 502, 503, 504, 529],
    "max_fallback_attempts": 6,
    "cooldown_seconds": 300,
    "timeout_seconds": 120,
    "notify_on_fallback": true,
    "restore_primary_after_cooldown": true
  },
  "tmux": {
    "enabled": true,
    "layout": "main-horizontal",
    "main_pane_size": 60,
    "main_pane_min_width": 40,
    "agent_pane_min_width": 40,
    "isolation": "inline"
  },
  "git_master": {
    "commit_footer": false,
    "include_co_authored_by": false,
    "git_env_prefix": "GIT_MASTER=1"
  },
  "agents": {
    "sisyphus": {
      "model": "anthropic/claude-opus-4-8",
      "reasoningEffort": "medium",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "medium" },
        { "model": "google/antigravity-gemini-3.1-pro", "reasoningEffort": "medium" },
        "opencode/nemotron-3-ultra-free"
      ]
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        "google/antigravity-gemini-3.5-flash",
        "anthropic/claude-sonnet-5",
        "opencode/north-mini-code-free"
      ]
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "google/antigravity-gemini-3.1-pro",
        "anthropic/claude-opus-4-8",
        "opencode/nemotron-3-ultra-free"
      ]
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "google/antigravity-gemini-3-flash",
        "anthropic/claude-haiku-4-5",
        "opencode/deepseek-v4-flash-free"
      ]
    },
    "multimodal-looker": {
      "model": "google/antigravity-gemini-3.5-flash",
      "fallback_models": [
        "google/antigravity-gemini-3.1-pro",
        { "model": "openai/gpt-5.5", "variant": "medium" },
        "anthropic/claude-sonnet-5"
      ]
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "max",
      "fallback_models": [
        "google/antigravity-gemini-3.1-pro",
        "anthropic/claude-opus-4-8",
        "opencode/nemotron-3-ultra-free"
      ]
    },
    "metis": {
      "model": "anthropic/claude-opus-4-8",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "max" },
        "google/antigravity-gemini-3.1-pro",
        "opencode/nemotron-3-ultra-free"
      ]
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        "google/antigravity-gemini-3.1-pro",
        "anthropic/claude-opus-4-8",
        "opencode/nemotron-3-ultra-free"
      ]
    },
    "atlas": {
      "model": "openai/gpt-5.5",
      "fallback_models": [
        "google/antigravity-gemini-3.5-flash",
        "anthropic/claude-sonnet-5",
        "opencode/deepseek-v4-flash-free"
      ]
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4-mini",
      "fallback_models": [
        "google/antigravity-gemini-3-flash",
        "anthropic/claude-haiku-4-5",
        "opencode/north-mini-code-free"
      ]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "google/antigravity-gemini-3.5-flash",
      "fallback_models": [
        { "model": "openai/gpt-5.5", "variant": "high" },
