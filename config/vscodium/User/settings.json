{
    "files.associations": {
        ".env*": "dotenv"
    },
    "files.watcherExclude": {
        "**/.git/objects/**": true,
        "**/.git/subtree-cache/**": true,
        "**/node_modules/*/**": true,
        "**/public/system/*/**": true
    },
    "editor.tokenColorCustomizations": {
        "textMateRules": [
            {
                "scope": "keyword.other.dotenv",
                "settings": {
                    "foreground": "#FF000000"
                }
            }
        ]
    },
    "workbench.sideBar.location": "right",
    "editor.inlineSuggest.suppressSuggestions": true,
    "workbench.activityBar.location": "top",
    "editor.minimap.enabled": false,
    "security.workspace.trust.untrustedFiles": "open",
    "containers.containers.label": "ContainerName",
    "workbench.editor.editorActionsLocation": "titleBar",
    "window.commandCenter": false,
    "workbench.editor.wrapTabs": true,
    "editor.wordWrapColumn": 120,
    "chat.tools.terminal.autoApprove": {
        "yarn test": true,
        "bin/run": true
    },
    "git.enableSmartCommit": true,
    "terminal.integrated.enableMultiLinePasteWarning": "never",
    "git.confirmSync": false,
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true
        },
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml"
    },
    "terminal.integrated.env.linux": {
        "EDITOR": "codium --wait"
    },
    "terminal.integrated.defaultProfile.linux": "zsh",
    "terminal.integrated.profiles.linux": {
        "bash": {
            "path": "bash",
            "icon": "terminal-bash"
        },
        "zsh": {
            "path": "zsh",
            "icon": "terminal-compact"
        },
        "tmux": {
            "path": "tmux",
            "icon": "terminal-tmux",
            "args": [
                "new",
                "-A",
                "-s",
                "${workspaceFolderBasename}"
            ]
        },
        "tmux-new": {
            "path": "tmux",
            "args": [
                "new",
                "-A",
                "-s",
                "${workspaceFolderBasename};",
                "new-window"
            ]
        },
        "Claude": {
            "path": "claude",
            "icon": "claude",
            "color": "terminal.ansiYellow",
            "overrideName": true
        },
        "Codex": {
            "path": "codex",
            "icon": "openai",
            "color": "terminal.ansiBlack",
            "overrideName": true
        },
        "opencode": {
            "path": "tmux",
            "args": [
                "new",
                "-A",
                "-s",
                "${workspaceFolderBasename}-oc",
                "opencode"
            ],
            "icon": "robot",
            "color": "terminal.ansiWhite",
            "overrideName": true
        }
    },
    "terminal.integrated.stickyScroll.ignoredCommands": [
        "clear",
        "cls",
        "clear-host",
        "agent",
        "agy",
        "copilot",
        "claude",
        "codex",
        "gemini",
        "opencode"
    ],
    "terminal.integrated.fontFamily": "'MesloLGS NF'",
    "terminal.integrated.tabs.location": "left",
    "terminal.integrated.scrollback": 5000,
    "editor.formatOnSave": true,
    "editor.stickyScroll.maxLineCount": 8,
    "editor.rulers": [
        120
    ],
    "rubyLsp.enabledFeatures": {
        "codeActions": true,
        "diagnostics": true,
        "documentHighlights": true,
        "documentLink": true,
        "documentSymbols": true,
        "foldingRanges": true,
        "formatting": true,
        "hover": true,
        "inlayHint": true,
        "onTypeFormatting": true,
        "selectionRanges": true,
        "semanticHighlighting": true,
        "completion": true,
        "codeLens": true,
        "definition": true,
        "workspaceSymbol": true,
        "signatureHelp": true,
        "typeHierarchy": true
    },
    "rubyLsp.featureFlags": {
        "fullTestDiscovery": true
    },
    "githubPullRequests.queries": [
        {
            "label": "Local Pull Request Branches",
            "query": "default"
        },
        {
            "label": "Waiting For My Review",
            "query": "repo:${owner}/${repository} is:open draft:false"
        },
        {
            "label": "Drafts",
            "query": "repo:${owner}/${repository} is:open draft:true"
        },
        {
            "label": "Created By Me",
            "query": "repo:${owner}/${repository} is:open author:${user}"
        },
        {
            "label": "All Open",
            "query": "default"
        }
    ],
    "editor.tabSize": 2,
    "editor.fontFamily": "'MesloLGS NF'",
    "files.trimFinalNewlines": true,
    "editor.trimWhitespaceOnDelete": true,
    "redhat.telemetry.enabled": false,
    "[jsonc]": {
        "editor.formatOnSave": true,
        "editor.quickSuggestions": {
            "strings": true
        },
        "editor.suggest.insertMode": "replace"
    },
    "[ruby]": {
        "editor.defaultColorDecorators": "never",
        "editor.defaultFormatter": "Shopify.ruby-lsp",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.insertSpaces": true,
        "editor.semanticHighlighting.enabled": true,
        "editor.formatOnType": true,
        "editor.wordSeparators": "`~@#$%^&*()-=+[{]}\\|;:'\",.<>/"
    },
    "githubPullRequests.terminalLinksHandler": "github",
    "window.menuBarVisibility": "compact",
    "yaml.schemas": {
        "file:///home/mauricio/.vscode/extensions/continue.continue-1.2.24-linux-x64/config-yaml-schema.json": [
            ".continue/**/*.yaml"
        ],
        "file:///home/mauricio/.vscode-server/extensions/docsmsft.docs-yaml-1.0.6/dist/toc.schema.json": "/toc\\.yml/i"
    },
    "markiscodecoverage.searchCriteria": "**/coverage/lcov*.info",
    "[erb]": {
        "editor.defaultFormatter": "Shopify.ruby-lsp"
    },
    "git.openRepositoryInParentFolders": "never",
    "githubPullRequests.pullBranch": "never",
    "json.schemaDownload.trustedDomains": {
        "https://biomejs.dev": true,
        "https://developer.microsoft.com/json-schemas/": true,
        "https://json-schema.org/": true,
        "https://json.schemastore.org/": true,
        "https://models.dev": true,
        "https://opencode.ai": true,
        "https://raw.githubusercontent.com/": true,
        "https://raw.githubusercontent.com/devcontainers/spec/": true,
        "https://raw.githubusercontent.com/microsoft/vscode/": true,
        "https://schemastore.azurewebsites.net/": true,
        "https://www.schemastore.org/": true
    },
    "workbench.colorTheme": "Dark Modern",
    "github-actions.workflows.pinned.refresh.enabled": true,
    "githubPullRequests.notifications": "pullRequests",
    "yaml.format.printWidth": 120,
    "yaml.format.proseWrap": "never",
    "yaml.format.singleQuote": true,
    "git.detectWorktrees": true,
    "git.worktreeIncludeFiles": [
        ".env"
    ],
    "obsidian-md-vsc.defaultVault": "Inscripto",
    "obsidian-md-vsc.defaultVaultPath": "/home/mauricio/Documents/obsidian/Inscripto",
    "obsidian-md-vsc.defaultNote": "Notes",
    "security.promptForLocalFileProtocolHandling": false,
    "[haml]": {
        "editor.defaultFormatter": "karunamurti.haml"
    },
    "workbench.startupEditor": "none",
    "workbench.browser.dataStorage": "workspace",
    "chat.disableAIFeatures": true,
    "terminal.integrated.initialHint": false,
    "linter.linters": {
        "brakeman": {
            "capabilities": [],
            "command": [
                [
                    "$isBundler",
                    "bundle",
                    "exec"
                ],
                "brakeman",
                "--format",
                "json",
                "--no-progress",
                "--quiet",
                "--absolute-paths",
                [
                    "$config",
                    "--config-file",
                    "$config"
                ],
                "$rootDir"
            ],
            "configFiles": [
                "brakeman.yml",
                "config/brakeman.yml",
                ".brakeman/config.yml"
            ],
            "enabled": false,
            "languages": [
                "ruby",
                "ruby-puma",
                "ruby-bundler",
                "ruby-test",
                "erb"
            ],
            "name": "brakeman",
            "url": "https://brakemanscanner.org/",
            "when": [
                "$isRails"
            ]
        },
        "cargo-clippy": {
            "capabilities": [
                "fix-inline",
                "ignore-file"
            ],
            "command": [
                "cargo-clippy",
                "$file",
                "--no-deps",
                "--message-format",
                "json",
                [
                    "$config",
                    "--config",
                    "$config"
                ]
            ],
            "configFiles": [
                "clippy.toml",
                ".clippy.toml"
            ],
            "enabled": true,
            "languages": [
                "rust"
            ],
            "name": "cargo-clippy",
            "url": "https://doc.rust-lang.org/clippy/"
        },
        "credo": {
            "capabilities": [
                "ignore-line",
                "ignore-file"
            ],
            "command": [
                "mix",
                "credo",
                "--format",
                "json",
                "--read-from-stdin",
                "--all-priorities",
                "$file"
            ],
            "configFiles": [],
            "enabled": true,
            "languages": [
                "elixir"
            ],
            "name": "credo",
            "url": "https://hexdocs.pm/credo/"
        },
        "dart": {
            "capabilities": [],
            "command": [
                "dart",
                "analyze",
                "$file"
